    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/lmstudio-mcp.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "lmstudio",
    "lm-studio",
    "mcp",
    "model-context-protocol",
    "claude-code",
